diff --git a/handler.test.mjs b/handler.test.mjs
index b47cd21..c2f43e5 100644
--- a/handler.test.mjs
+++ b/handler.test.mjs
@@ -9,5 +9,63 @@ test('accepts the event', async () => {
     method: 'POST', body: JSON.stringify({ id: 'event-1', value: 'note' })
   }), env, { waitUntil() {} });
   assert.equal(response.status, 201);
-  assert.equal(writes.length, 1);
+  assert.deepEqual(writes, [['event-1', 'note']]);
+});
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((resolvePromise, rejectPromise) => {
+    resolve = resolvePromise;
+    reject = rejectPromise;
+  });
+  return { promise, resolve, reject };
+}
+
+test('reports Saved only after the storage write completes', async () => {
+  const write = deferred();
+  const started = deferred();
+  const env = { STORE: { put: () => {
+    started.resolve();
+    return write.promise;
+  } } };
+  let responseSettled = false;
+  const responsePromise = handler.fetch(new Request('https://example.invalid', {
+    method: 'POST', body: JSON.stringify({ id: 'event-1', value: 'note' })
+  }), env, { waitUntil() {} });
+  responsePromise.then(
+    () => { responseSettled = true; },
+    () => { responseSettled = true; }
+  );
+
+  await started.promise;
+  await Promise.resolve();
+  const settledBeforeWriteCompleted = responseSettled;
+  write.resolve();
+  const response = await responsePromise;
+
+  assert.equal(settledBeforeWriteCompleted, false,
+    'The response must remain pending while the required write is pending');
+  assert.equal(response.status, 201);
+  assert.equal(await response.text(), 'Saved');
+});
+
+test('propagates storage failure instead of reporting Saved', async () => {
+  const write = deferred();
+  const started = deferred();
+  const failure = new Error('Storage unavailable');
+  // Observe the write rejection even when the unfixed handler ignores it.
+  write.promise.catch(() => {});
+  const env = { STORE: { put: () => {
+    started.resolve();
+    return write.promise;
+  } } };
+  const responsePromise = handler.fetch(new Request('https://example.invalid', {
+    method: 'POST', body: JSON.stringify({ id: 'event-1', value: 'note' })
+  }), env, { waitUntil() {} });
+  const rejectedResponse = assert.rejects(responsePromise, error => error === failure);
+
+  await started.promise;
+  write.reject(failure);
+  await rejectedResponse;
 });
